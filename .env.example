# Copy to .env and fill in. Never commit .env.
# Load with: set -a && . ./.env && set +a
#
# build_workflow.py reads .env (or this file if .env is missing) and bakes the
# values into workflow/update-netbox.json, because n8n blocks $env inside Code
# nodes. Rebuild after any change:  python3 workflow/build_workflow.py
# Variables already set in your shell override the file.
# N8N_URL / N8N_TOKEN / N8N_WORKFLOW_ID / N8N_WEBHOOK_BASE are only used when
# pulling/pushing the workflow through the n8n API and for webhook test calls,
# not by the build.

# --- n8n API ---
N8N_URL=http://REPLACEME:1111
N8N_TOKEN=REPLACEME_N8N_API_KEY
N8N_WORKFLOW_ID=REPLACEME_WORKFLOW_ID
# Public base URL for webhook test calls
N8N_WEBHOOK_BASE=https://REPLACEME:4111

# --- Workflow values: workflow/code/load_config.js ---
NETBOX_URL=http://REPLACEME:8851
NETBOX_TOKEN=REPLACEME_NETBOX_TOKEN
NTOPNG_URL=https://REPLACEME:3000
NTOPNG_TOKEN=REPLACEME_NTOPNG_TOKEN
NTOPNG_IFID=0
VCENTER_URL=https://REPLACEME
VCENTER_USER=REPLACEME_VCENTER_USER
VCENTER_PASSWORD=REPLACEME_VCENTER_PASSWORD

# --- Workflow values: workflow/code/validate_xml.js and pull_config.sh ---
# Shared secret; pfSense sends it as the X-Pfsense-Token header.
PFSENSE_WEBHOOK_TOKEN=REPLACEME_PFSENSE_WEBHOOK_TOKEN

# --- Workflow values: workflow/build_workflow.py ---
# Shared secret for the "run sync now" webhook. Callers must send it as the
# X-Sync-Token header, otherwise the webhook answers 401 and nothing runs.
# Must not be empty (the build fails on purpose).
SYNC_WEBHOOK_TOKEN=REPLACEME_SYNC_WEBHOOK_TOKEN

# true to accept self-signed / untrusted TLS certificates when calling NetBox,
# ntopng and vCenter. Leave false unless those services use self-signed certs;
# with true, anyone on the network path can read the credentials sent to them.
SKIP_TLS_VERIFY=false

DISCORD_WEBHOOK=https://discord.com/api/webhooks/REPLACEME/REPLACEME

# --- Workflow values: workflow/code/sync_helpers.js (primaryIp) ---
# Subnets whose addresses are preferred as a host's primary IP.
# Comma-separated; earlier entries have priority, e.g. 10.0.0.0/24,10.0.1.0/24
# Add more networks by appending ",x.x.x.x/nn". If none match, the code falls back
# to the ntopng IP, then the host's other IPs.
PRIMARY_IP_CIDR=REPLACEME/24

# --- Workflow values: join_inventory.js, sync_helpers.js ---
# Exact name of the pfSense VM in vCenter/NetBox. If not found, the first powered-on
# VM with "pfsense" in its name is used.
PFSENSE_VM_NAME=REPLACEME_PFSENSE_VM

# --- Workflow behaviour: workflow/code/load_config.js ---
# true/1 to skip NetBox writes
DRY_RUN=false
# true/1 to skip powered-off VMs
POWERED_ON_ONLY=false
